---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import IntakeForm from '../components/IntakeForm.astro';
import { whatsappWith } from '../config/site';

// "Plan een gratis intake" (handoff 2026-09-30, decision D37): fewer fields, no time pickers and no
// Google appointment page. The visitor writes what costs too much time and when it suits them; Micky
// answers within a day with a proposal (30 minutes, Google Meet or phone). The form itself, its
// success state and the send logic live in src/components/IntakeForm.astro.
const wa = whatsappWith('Hoi Micky, ik heb een proces dat te veel tijd kost: ');
---
<Layout
  title="Plan een gratis intake"
  description="Plan een gratis intake van 30 minuten via Google Meet of telefoon. Vertel wat te veel tijd kost en wanneer het jou uitkomt; ik reageer binnen een dag."
>
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="orb right-[8%] top-10 hidden h-24 w-24 animate-drift [--orb-a:#D4F75B] [--orb-b:#8FBF1C] [--orb-c:#33470C] md:block"></div>
    </div>
    <div class="wrap relative z-10 grid gap-10 py-14 sm:py-20 lg:grid-cols-[2fr_3fr] lg:gap-16">
      <div class="grid content-start gap-5">
        <p class="text-sm font-bold animate-rise"><a href="/automatisering/" class="text-violet hover:underline">AI-automatisering</a></p>
        <p class="eyebrow animate-rise [animation-delay:.05s]">Gratis · 30 minuten · Google Meet of telefoon</p>
        <h1 class="text-[36px] font-extrabold leading-[1.05] tracking-tight animate-rise [animation-delay:.1s] sm:text-[48px]">Plan een gratis intake.</h1>
        <p class="max-w-prose text-lg text-muted animate-rise [animation-delay:.2s]">Je hoeft het niet uitgedacht te hebben. Vertel in één zin wat te veel tijd kost en wanneer het jou uitkomt, en ik reageer binnen een dag met een voorstel. Het gesprek is vrijblijvend en verplicht je tot niets.</p>
        <ul class="grid gap-3 text-[15px] animate-rise [animation-delay:.3s]">
          {['We bespreken wat je stoort en hoe het werk nu loopt', 'Je hoort direct of het zin heeft', 'Daarna krijg je een vaste inschatting van dagen en kosten'].map((t) => (
            <li class="flex gap-2">
              <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-0.5 flex-none"><path d="M4 10.5l4 4 8-9" stroke="#6D28D9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span>{t}</span>
            </li>
          ))}
        </ul>
        <p class="text-sm text-muted animate-rise [animation-delay:.35s]">Liever appen? <a href={wa} rel="noopener" class="font-bold text-violet underline underline-offset-2">Stuur een WhatsApp</a>.</p>
        <figure class="flex items-center gap-3 animate-rise [animation-delay:.4s]">
          <img src="/images/micky/micky-van-zadelhoff-portret.webp" alt="Micky van Zadelhoff" width="64" height="64" loading="lazy" class="h-14 w-14 flex-none rounded-full border-2 border-ink object-cover sm:h-16 sm:w-16" />
          <figcaption class="text-sm font-semibold">Je spreekt met mij, niet met een verkoper.</figcaption>
        </figure>
      </div>

      <div class="animate-rise [animation-delay:.2s]">
        <IntakeForm voor="automatisering" />
      </div>
    </div>
  </section>
</Layout>
