---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ClientStrip from '../components/ClientStrip.astro';
import { FACTS, SITE, whatsappWith } from '../config/site';
const wa = whatsappWith('Hoi Micky, ik heb een proces dat te veel tijd kost: ');

// Briefing 2 (2026-09-15): the fixed-price "Bouwen met Claude Code" week became this service page.
// Sells the outcome (a working automation, built with the customer's own people), not the tool.
import { spot } from '../lib/spots';

// Handoff 2026-09-29: the questions entrepreneurs actually ask, in their own words, then what gets built.
const areas = [
  { icon: 'auto-klantcontact', title: 'Klantcontact', items: [
    { q: 'Mijn mail kost me elke ochtend een uur.', a: 'Outlook of Gmail sorteert op urgentie en zet concept-antwoorden klaar in jouw toon. Verzenden doe je zelf.' },
    { q: 'Klanten appen ons de hele dag dezelfde vragen.', a: 'WhatsApp beantwoordt openingstijden, orderstatus en voorraad uit jullie eigen gegevens. Wat afwijkt gaat naar een collega.' },
    { q: 'Klanten vragen steeds hetzelfde over onze producten.', a: 'Antwoorden op basis van jullie eigen handleidingen, niet op basis van wat AI toevallig denkt te weten.' },
    { q: 'Klachten belanden bij de verkeerde persoon.', a: 'Samengevat en bij de juiste collega neergelegd, met de context erbij.' },
  ] },
  { icon: 'auto-verkoop', title: 'Verkoop en offertes', items: [
    { q: 'Aanvragen blijven twee dagen liggen.', a: 'Een aanvraag uit het contactformulier of de mail staat binnen een minuut in het CRM, met een concept-antwoord klaar.' },
    { q: 'Een offerte maken kost me elke avond.', a: 'Een offerte uit een telefoonnotitie of een binnengekomen mail, in eigen huisstijl en met de juiste staffelprijzen.' },
    { q: 'Van de helft van de offertes horen we nooit meer iets.', a: 'Na een afgesproken aantal dagen staat een concept-opvolging klaar.' },
    { q: 'Na een klantgesprek is de helft van de afspraken weg.', a: 'Een gesprek of Teams-meeting wordt notulen, actiepunten en een bijgewerkt CRM.' },
  ] },
  { icon: 'auto-administratie', title: 'Administratie en facturen', items: [
    { q: 'Ons boekhoudpakket leest facturen in, maar controleert niets.', a: 'Inkoopfacturen en pakbonnen worden gematcht met bestellingen, met een signaal als iets niet klopt. Het deel dat Exact of Moneybird niet voor je doet.' },
    { q: 'Declaraties controleren kost een dag per maand.', a: 'Bonnetjes en declaraties uitgelezen, gecontroleerd en klaargezet voor de boekhouding.' },
    { q: 'Urenbriefjes komen als WhatsApp-foto binnen.', a: 'Direct in de urenregistratie.' },
    { q: 'Elke maandag knip-en-plak tussen webshop, boekhouding en Excel.', a: 'Een koppeling tussen je systemen, met AI voor het deel dat niet netjes in een kolom past.' },
    { q: 'Contracten invullen en nalopen doen we met de hand.', a: 'Standaardcontracten gevuld en gecontroleerd op afwijkingen van jullie standaard.' },
  ] },
  { icon: 'auto-planning', title: 'Planning', items: [
    { q: 'Afspraken inplannen kost meer tijd dan de afspraak.', a: 'Een verzoek wordt een voorstel in de agenda en een bevestiging.' },
    { q: 'Kan AI ook onze roosters, ritten of bestellingen plannen?', a: 'Ja, maar dat is een langer traject dan een week, en dat zeg ik eerlijk in de intake.' },
  ] },
  { icon: 'auto-rapportage', title: 'Rapportage', items: [
    { q: 'Elke maandag klikt iemand hetzelfde rapport in elkaar.', a: 'Een wekelijkse managementsamenvatting uit systemen die niet met elkaar praten.' },
    { q: 'Wat zeggen onze klanten eigenlijk?', a: 'Reviews, klachten en supportmails per maand samengevat, met een reactie klaar.' },
  ] },
  { icon: 'auto-personeel', title: 'Personeel', items: [
    { q: 'Een vacaturetekst schrijven duurt een dag.', a: 'Vacatureteksten uit jullie eigen functieprofielen, en sollicitaties samengevat met de administratie eromheen. Beoordelen blijft mensenwerk, dat wil de AI Act ook.' },
    { q: 'Iedereen vraagt HR hetzelfde over verlof.', a: 'Vragen over verlof, verzuim en regelingen beantwoord uit jullie eigen personeelshandboek.' },
    { q: 'Iemand inwerken kost elke keer een week van een collega.', a: 'Inwerkinstructies en een vraagbaak uit de documenten die er al zijn.' },
  ] },
  { icon: 'auto-marketing', title: 'Marketing en webshop', items: [
    { q: 'Vierhonderd productteksten, wie gaat dat schrijven?', a: 'Productteksten uit specsheets, honderden artikelen tegelijk.' },
    { q: 'Onze webshop moet ook in het Duits.', a: 'De hele catalogus vertaald naar Duits, Engels of Frans.' },
    { q: 'We doen niks met social omdat niemand tijd heeft.', a: 'Social posts uit projectfoto\'s.' },
  ] },
  { icon: 'auto-kennis', title: 'Kennis en documenten', items: [
    { q: 'Niemand vindt meer iets terug in die map met pdf\'s.', a: 'Handleidingen, contracten en normen doorzoekbaar, zodat niemand meer door een archiefmap spit.' },
    { q: 'Subsidieaanvragen en aanbestedingen kosten avonden.', a: 'Een eerste versie uit eerdere aanvragen en het bestek, plus een checklist met knelpunten.' },
    { q: 'Dat rapport van zestig pagina\'s leest niemand.', a: 'Samengevat tot wat er voor jullie in staat.' },
  ] },
];

// Spot illustrations per area (public/images/spots/auto-*.webp, generated with scripts/generate-spots.mjs).

const steps = [
  { title: 'Intake, vrijblijvend', text: 'We bespreken wat je stoort, hoe het werk nu loopt en wat je hoopt te bereiken. Hierna weet je of het zin heeft, en krijg je een offerte met een inschatting van de tijd die nodig is.' },
  { title: 'Verkennen op de werkvloer', text: 'Ik draai mee en kijk hoe het bij jullie écht gaat. Dit is het moment waarop er dingen bovenkomen waarvan niemand wist dat ze konden. Daarna bepalen we samen wat we wel en niet aan AI overlaten. Dat "niet" is net zo belangrijk: sommige dingen horen bij een mens te blijven.' },
  { title: 'Bouwen', text: 'Ik bouw het systeem, samen met de mensen die het straks gebruiken. Zij kijken niet toe, ze doen mee. Dat is precies waarom het daarna blijft werken.' },
  { title: 'In gebruik nemen', text: 'Zodra het staat gaat het gebruikt worden, met echt werk en echte data. Niet als demo, maar in productie.' },
  { title: 'Verbeteren en overdragen', text: 'Wat in de praktijk schuurt passen we aan. Daarna kijken we vooruit: hoe houd je het scherp, wie beheert het, wat doe je als er iets verandert.' },
];

const results = [
  'Een werkende automatisering, tool of applicatie, gebouwd voor jouw bedrijf en jouw manier van werken',
  'Twee mensen die begrijpen hoe het in elkaar zit en het zelf kunnen bijstellen',
  '<strong>Een jaar service van mij</strong> voor onderhoud als dat nodig is. Meestal is dat niet nodig, maar je weet dat je niet alleen staat',
  'Alles staat bij jullie. Geen abonnement bij mij, geen afhankelijkheid',
];

// Wat het kost (Micky, 2026-09-30): the typical project size in days and euros, plus three worked examples with
// assumptions, not client cases. The bars compare investment and yearly saving on one scale (the largest saving).
const examples = [
  { title: 'Mail voorsorteren en concept-antwoorden', text: "Twee medewerkers zijn elk 45 minuten per dag kwijt aan standaardmail. Drie dagen bouwen: €3.600. Bespaart zo'n 345 uur per jaar; bij €40 loonkosten per uur ruim €13.000. Terugverdiend in ongeveer drie maanden.", days: 'Drie dagen', cost: '€3.600', costN: 3600, saving: 'ruim €13.000', hours: '±345 uur', savingN: 13800, payback: '±3 maanden' },
  { title: 'Aanvragen automatisch in het CRM, met concept-offerte', text: "Vijftien aanvragen per week, elk 20 minuten overtypen en voorbereiden. Vier dagen: €4.800. Bespaart zo'n 230 uur per jaar, ruim €9.000. En een reactie binnen een uur in plaats van na twee dagen, wat meestal meer oplevert dan de uren.", days: 'Vier dagen', cost: '€4.800', costN: 4800, saving: 'ruim €9.000', hours: '±230 uur', savingN: 9200, payback: '±6 maanden' },
  { title: 'Inkoopfacturen en pakbonnen matchen', text: "Driehonderd facturen per maand, vijf minuten controleren per stuk. Vijf dagen: €6.000. Bespaart zo'n 300 uur per jaar, €12.000, plus de dubbele betalingen die nu doorglippen.", days: 'Vijf dagen', cost: '€6.000', costN: 6000, saving: '€12.000', hours: '±300 uur', savingN: 12000, payback: '±6 maanden' },
];
const barMax = Math.max(...examples.map((e) => e.savingN));
const pct = (n: number) => Math.round((n / barMax) * 100);

const faq = [
  { q: 'Moet ons team technisch zijn?', a: 'Nee. De techniek is mijn werk. Wat wel helpt is iemand die het proces echt kent, want die weet welke uitzonderingen erin zitten.' },
  { q: 'Wat gebeurt er met onze data?', a: 'Alles wat ik bouw draait in jullie eigen omgeving, met jullie eigen toegangen. Voor gevoelige gegevens kan een model lokaal draaien, zodat er niets het pand verlaat. Wat wel en niet naar een externe AI-dienst mag, leggen we vast in de intake.' },
  { q: 'We hebben al software met AI-functies. Wat voeg jij toe?', a: 'Het deel ertussen. Je boekhoudpakket leest facturen in, je CRM heeft een chatbot, maar niemand verbindt ze en niemand vangt de uitzonderingen. Daar zit het handwerk, en daar bouw ik.' },
  { q: 'Werkt dit ook als we nog niets met AI doen?', a: 'Ja. Als je team eerst een gezamenlijke basis wil, is de <a href="/ai-workshops/ai-introductie/" class="font-bold text-violet underline underline-offset-2">AI Introductie</a> van drie uur daar de snelste manier voor.' },
  { q: 'Van wie is wat we bouwen?', a: 'Van jullie. De code, de toegang, de data. Ik bouw het bij jullie, niet bij mij.' },
  { q: 'Wat als het over drie maanden stukgaat?', a: 'Daar is de service van een jaar voor. Wat daaronder valt spreken we af in de offerte, omdat het per systeem enorm verschilt.' },
  { q: 'Gaan er banen verdwijnen?', a: 'Niet in wat ik bouw. Wat verdwijnt is het overtypen, het uitzoeken en het handmatig optellen. De mensen die dat nu doen weten meestal als eerste waar de volgende winst zit.' },
  { q: 'Kom je ook buiten de Randstad?', a: 'Ik werk in heel Nederland en België, en daarbuiten in overleg. Reis- en verblijfkosten staan in de offerte.' },
];
---
<Layout
  title="AI-automatisering voor je bedrijf, gebouwd met je eigen team"
  description="Ik kom meedraaien op je afdeling en automatiseer met AI wat te veel tijd kost: mail, offertes, facturen. Gratis intake, meestal €3.600 – 6.000 per traject."
>
  <!-- Hero: copy left, "chaos becomes order" illustration right -->
  <section class="relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="orb right-[8%] top-8 h-24 w-24 animate-drift [--orb-a:#D4F75B] [--orb-b:#8FBF1C] [--orb-c:#33470C] sm:h-32 sm:w-32"></div>
    </div>
    <div class="wrap relative z-10 grid items-center gap-10 py-14 sm:py-20 md:grid-cols-[7fr_5fr]">
      <div class="grid gap-5">
        <p class="text-sm font-bold animate-rise"><a href="/ai-workshops/" class="text-violet hover:underline">AI-workshops</a></p>
        <p class="eyebrow animate-rise [animation-delay:.05s]">AI-automatisering · op locatie · Nederland en België</p>
        <h1 class="max-w-3xl text-[38px] font-extrabold leading-[1.04] tracking-tight animate-rise [animation-delay:.1s] sm:text-[54px]">Ik kom meedraaien en automatiseer wat <span class="highlight">te veel tijd</span> kost.</h1>
        <p class="max-w-prose text-lg text-muted animate-rise [animation-delay:.2s] sm:text-xl">Geen presentatie over wat AI ooit zou kunnen. Ik kom naar je bedrijf, kijk mee met hoe het werk nu echt gaat, en bouw samen met je eigen mensen een systeem dat het saaiste deel overneemt: de mail, de offertes, de facturen, het overtypen. Aan het eind draait het, in jullie eigen systemen, en begrijpen jullie precies hoe het werkt.</p>
        <div class="flex flex-wrap gap-3 animate-rise [animation-delay:.3s]">
          <a href={wa} rel="noopener" class="btn btn-primary">Stuur een WhatsApp</a>
          <a href="/intake/" class="btn btn-ghost">Plan een gratis intake</a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-[460px] animate-rise [animation-delay:.3s]">
        <svg viewBox="0 0 520 400" class="h-auto w-full" aria-hidden="true" fill="none" stroke="#17112E" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <!-- left: scattered documents -->
          <g transform="rotate(-14 90 120)"><rect x="50" y="70" width="80" height="100" rx="12" fill="#FFFFFF"/><path d="M66 94h48M66 110h48M66 126h30" stroke="#A78BFA"/></g>
          <g transform="rotate(11 150 250)"><rect x="110" y="200" width="80" height="100" rx="12" fill="#EDE9FE"/><path d="M126 224h48M126 240h48M126 256h30" stroke="#6D28D9"/></g>
          <g transform="rotate(-6 70 320)"><rect x="30" y="270" width="80" height="100" rx="12" fill="#FFFFFF"/><path d="M46 294h48M46 310h48M46 326h30" stroke="#A78BFA"/></g>
          <g transform="rotate(24 200 100)"><rect x="160" y="50" width="80" height="100" rx="12" fill="#F1FBC9"/><path d="M176 74h48M176 90h48M176 106h30" stroke="#6D28D9"/></g>
          <g transform="rotate(-20 215 200)"><rect x="175" y="150" width="80" height="100" rx="12" fill="#FFFFFF"/><path d="M191 174h48M191 190h48M191 206h30" stroke="#A78BFA"/></g>
          <!-- the flow: three violet threads converging into one -->
          <path d="M240 110 C 290 110, 300 200, 350 200" stroke="#6D28D9" stroke-width="3"/>
          <path d="M255 210 C 300 210, 300 200, 350 200" stroke="#6D28D9" stroke-width="3"/>
          <path d="M215 320 C 290 320, 300 200, 350 200" stroke="#6D28D9" stroke-width="3"/>
          <path d="M350 200 H 372" stroke="#6D28D9" stroke-width="3"/>
          <!-- right: a neat, even stream -->
          <g>
            <rect x="380" y="98" width="110" height="40" rx="10" fill="#FFFFFF"/><rect x="392" y="112" width="24" height="12" rx="6" fill="#D4F75B" stroke="none"/><path d="M426 118h48" stroke="#A78BFA"/>
            <rect x="380" y="152" width="110" height="40" rx="10" fill="#FFFFFF"/><rect x="392" y="166" width="24" height="12" rx="6" fill="#D4F75B" stroke="none"/><path d="M426 172h48" stroke="#A78BFA"/>
            <rect x="380" y="206" width="110" height="40" rx="10" fill="#FFFFFF"/><rect x="392" y="220" width="24" height="12" rx="6" fill="#D4F75B" stroke="none"/><path d="M426 226h48" stroke="#A78BFA"/>
            <rect x="380" y="260" width="110" height="40" rx="10" fill="#FFFFFF"/><rect x="392" y="274" width="24" height="12" rx="6" fill="#D4F75B" stroke="none"/><path d="M426 280h48" stroke="#A78BFA"/>
          </g>
          <!-- hard offset shadow, sticker-style -->
          <rect x="386" y="104" width="110" height="196" rx="14" fill="none" stroke="#17112E" stroke-dasharray="4 6" opacity=".35"/>
        </svg>
      </div>
    </div>
  </section>

  <!-- Recognition -->
  <section class="wrap py-6 sm:py-10">
    <div class="reveal sticker grid gap-5 bg-surface p-7 sm:p-10 md:grid-cols-[2fr_3fr] md:gap-10">
      <h2 class="text-2xl font-bold tracking-tight sm:text-[32px] sm:leading-[1.15]">Bijna elk bedrijf heeft een proces dat niemand meer ter discussie stelt</h2>
      <div class="grid gap-4 text-lg text-muted">
        <p>Iemand die elke maandag exports uit drie systemen met de hand aan elkaar plakt. Een postbus waar aanvragen binnenkomen die iemand overtypt in het CRM. Een map met vierhonderd pdf's waar niemand meer iets in terugvindt. Dat werk wordt gedaan omdat het altijd zo gegaan is, niet omdat het zo moet.</p>
        <p>Het gekke is dat de meeste ondernemers pas tijdens het meekijken ontdekken hoeveel er kan. In de intake noem je één ding dat je stoort. In de week erna komen er vijf bij waarvan je niet wist dat ze weg konden.</p>
      </div>
    </div>
  </section>

  <!-- What I take on: eight cards -->
  <section class="wrap py-14 sm:py-20">
    <div class="reveal grid max-w-3xl gap-3">
      <p class="eyebrow">Waar ik mee aan de slag ga</p>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Wat ondernemers me vragen.</h2>
      <p class="text-lg text-muted">Dit zijn de vragen waarmee ondernemers bij me komen, in hun eigen woorden. Bij alles geldt dezelfde regel: AI doet het voorwerk, een mens beslist en verstuurt.</p>
    </div>
    <div class="mt-10 grid gap-5 sm:grid-cols-2 lg:grid-cols-4">
      {areas.map((a, i) => (
        <div class="reveal sticker flex flex-col gap-4 bg-surface p-6" data-delay={(i % 4) + 1}>
          <img src={spot(a.icon)} alt="" width="96" height="96" loading="lazy" class="spot -mt-2 h-20 w-20 animate-bob [--tilt:4deg]" style={`animation-delay:${(i * 0.4) % 2}s`} />
          <h3 class="font-display text-lg font-bold leading-snug">{a.title}</h3>
          <ul class="grid gap-2.5 text-[15px] leading-snug text-muted">
            {a.items.map((it) => (
              <li class="flex gap-2"><span class="mt-[9px] h-1.5 w-1.5 flex-none rounded-full bg-violet" aria-hidden="true"></span><span><strong class="text-ink">"{it.q}"</strong> {it.a}</span></li>
            ))}
          </ul>
        </div>
      ))}
    </div>
    <p class="reveal mt-8 text-lg font-semibold">Staat het er niet bij? <a href={wa} rel="noopener" class="text-violet underline underline-offset-2">App me.</a> De kans is groot dat het toch kan.</p>
  </section>

  <!-- How it goes: five steps + side box -->
  <section class="band-dark relative overflow-hidden">
    <div class="wrap relative z-10 py-16 sm:py-24">
      <div class="reveal grid gap-3">
        <p class="eyebrow">Zo ziet zo'n traject eruit</p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Hoe het gaat</h2>
      </div>
      <div class="mt-10 grid gap-10 lg:grid-cols-[3fr_2fr] lg:gap-16">
        <ol class="relative grid gap-8 before:absolute before:bottom-6 before:left-[22px] before:top-6 before:w-[3px] before:bg-violet before:content-['']">
          {steps.map((s, i) => (
            <li class="reveal relative grid grid-cols-[46px_1fr] gap-4" data-delay={i + 1}>
              <span class:list={['relative z-10 inline-flex h-[46px] w-[46px] items-center justify-center rounded-full border-2 border-ink font-display text-lg font-bold', i === 0 ? 'bg-lime text-ink' : 'bg-surface text-ink']}>{i + 1}</span>
              <div class="pt-2">
                <h3 class="font-display text-xl font-bold">{s.title}</h3>
                <p class="mt-2 max-w-prose text-white/80">{s.text}</p>
              </div>
            </li>
          ))}
        </ol>
        <aside class="reveal sticker h-fit bg-violet p-6 text-white sm:p-8 lg:sticky lg:top-24" data-delay={2}>
          <p class="eyebrow text-lime">Ter illustratie</p>
          <p class="mt-3 text-lg leading-relaxed">Bij een afgebakende automatisering staat het geheel vaak op dag vier voor de lunch, en wordt het diezelfde middag in gebruik genomen. De laatste dag is voor de verbeterronde. Hoeveel tijd jouw vraagstuk kost, bepalen we in de intake.</p>
        </aside>
      </div>
    </div>
  </section>

  <!-- Who sits at the table + what you keep -->
  <section class="wrap py-16 sm:py-24">
    <div class="grid gap-8 md:grid-cols-2">
      <div class="reveal sticker grid gap-4 bg-violet-soft p-7 sm:p-9">
        <p class="eyebrow">Wie erbij zit</p>
        <h2 class="text-2xl font-bold tracking-tight sm:text-[30px] sm:leading-[1.15]">Twee mensen van jouw kant, meer niet</h2>
        <p class="text-muted">Iemand die het proces door en door kent, want die weet welke uitzonderingen er in de praktijk zijn. En iemand die hoger in de organisatie zit, want er moeten knopen worden doorgehakt zonder dat we een week op akkoord wachten.</p>
        <p class="font-semibold">Beiden hoeven niets van techniek te weten. Dat deel neem ik voor mijn rekening.</p>
      </div>
      <div class="reveal sticker grid gap-4 bg-surface p-7 sm:p-9" data-delay={1}>
        <p class="eyebrow">Wat je overhoudt</p>
        <h2 class="text-2xl font-bold tracking-tight sm:text-[30px] sm:leading-[1.15]">Aan het eind staat er iets dat werkt</h2>
        <ul class="grid gap-3">
          {results.map((r) => (
            <li class="flex gap-3">
              <svg width="22" height="22" viewBox="0 0 20 20" fill="none" aria-hidden="true" class="mt-0.5 flex-none"><path d="M4 10.5l4 4 8-9" stroke="#6D28D9" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"/></svg>
              <span set:html={r} />
            </li>
          ))}
        </ul>
      </div>
    </div>
  </section>

  <!-- Proof -->
  <section class="wrap pb-6">
    <div class="reveal grid gap-6 md:grid-cols-[1fr_2fr] md:items-start">
      <div class="grid gap-3">
        <p class="eyebrow">Bewijs</p>
        <h2 class="text-3xl font-bold tracking-tight">Ik bouw zelf ook</h2>
        <a href="/over/" class="btn btn-ghost w-fit">Lees mijn verhaal</a>
      </div>
      <div class="grid gap-4 text-lg text-muted">
        <p>Op het kamp dat we elke zomer runnen, telde iemand elke week met de hand natte turflijstjes op om te weten wie wat gedronken had. Ik bouwde er in een paar uur een app voor. Diezelfde zomer bewees hij zich.</p>
        <p>Datzelfde jaar bracht ik <a href="https://easyreimburse.ai/" rel="noopener" class="font-bold text-violet underline underline-offset-2">EasyReimburse</a> op de markt: deelnemers aan Europese projecten uploaden hun reisbewijzen, AI leest ze uit en de coördinator krijgt een auditklaar rapport. Ruim {FACTS.easyReimburseOrgs.replace('+', '')} organisaties gebruiken het en het scheelt ze per project een volle werkweek.</p>
        <p class="font-semibold text-ink">Sinds {FACTS.workshopsSince} gaf ik daarnaast {FACTS.workshops} AI-workshops aan meer dan {FACTS.participants.replace('+', '')} mensen.</p>
      </div>
    </div>
  </section>
  <ClientStrip compact />

  <!-- Price: typical project size, then three worked examples (Micky, 2026-09-30) -->
  <section class="wrap py-16 sm:py-24">
    <div class="reveal sticker relative overflow-hidden bg-lime p-8 sm:p-12">
      <div class="relative z-10 grid gap-8 md:grid-cols-[3fr_2fr] md:items-center">
        <div class="grid gap-4">
          <p class="eyebrow text-ink">Wat het kost</p>
          <h2 class="text-2xl font-bold sm:text-[36px] sm:leading-[1.1]">Meestal drie tot vijf dagen, en dan draait het.</h2>
          <p class="max-w-prose text-ink/80">Ik reken €150 per uur excl. btw. Een afgebakende automatisering kost meestal drie tot vijf dagen, dus €3.600 tot €6.000, inclusief een jaar service. Na de gratis intake krijg je een vaste inschatting, zodat je vooraf weet waar je aan toe bent. Geen abonnement bij mij: het systeem is van jullie. Wat het daarna kost zijn de AI- en hostingkosten, meestal enkele tientjes per maand.</p>
          <div class="flex flex-wrap gap-3">
            <a href="/intake/" class="btn btn-primary">Plan een gratis intake</a>
            <a href={wa} rel="noopener" class="btn btn-ghost">Stuur een WhatsApp</a>
          </div>
        </div>
        <div class="sticker grid gap-1 bg-surface p-6 text-center sm:p-8">
          <p class="font-display text-[32px] font-bold leading-none text-violet sm:text-[40px]">€3.600 – 6.000</p>
          <p class="text-sm font-bold uppercase tracking-[0.14em] text-muted">per traject</p>
          <p class="mt-3 text-sm text-muted">€150 per uur · gratis intake · een jaar service</p>
        </div>
      </div>
    </div>

    <div class="reveal mt-12 grid max-w-3xl gap-2">
      <h3 class="font-display text-2xl font-bold tracking-tight sm:text-3xl">Drie rekenvoorbeelden</h3>
      <p class="text-lg text-muted">Geen klantcases maar aannames. In de intake vullen we jouw cijfers in.</p>
    </div>
    <div class="mt-6 grid gap-5 md:grid-cols-3">
      {examples.map((e, i) => (
        <article class="reveal sticker flex flex-col gap-4 bg-surface p-6" data-delay={i + 1}>
          <h4 class="font-display text-lg font-bold leading-snug">{e.title}</h4>
          <p class="text-[15px] leading-snug text-muted">{e.text}</p>
          <dl class="mt-auto grid gap-3 border-t-2 border-line pt-4 text-sm">
            <div>
              <div class="flex items-baseline justify-between gap-3"><dt class="text-muted">Bouwen</dt><dd class="font-bold">{e.days} · {e.cost}</dd></div>
              <div class="bar" aria-hidden="true"><span class="bar__fill bar__fill--cost" style={`width:${pct(e.costN)}%`}></span></div>
            </div>
            <div>
              <div class="flex items-baseline justify-between gap-3"><dt class="text-muted">Bespaart per jaar</dt><dd class="font-bold">{e.hours} · {e.saving}</dd></div>
              <div class="bar" aria-hidden="true"><span class="bar__fill" style={`width:${pct(e.savingN)}%`}></span></div>
            </div>
            <div class="flex items-baseline justify-between gap-3"><dt class="text-muted">Terugverdiend</dt><dd class="font-display font-bold text-violet">{e.payback}</dd></div>
          </dl>
        </article>
      ))}
    </div>
  </section>

  <!-- FAQ -->
  <section class="wrap pb-16 sm:pb-24">
    <div class="reveal grid gap-3">
      <p class="eyebrow">Veelgestelde vragen</p>
      <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Wat ondernemers me eerst vragen</h2>
    </div>
    <dl class="mt-8 grid gap-5 md:grid-cols-2">
      {faq.map((f, i) => (
        <div class="reveal sticker bg-surface p-6" data-delay={(i % 2) + 1}>
          <dt class="font-display text-lg font-bold leading-snug">{f.q}</dt>
          <dd class="mt-2 text-muted" set:html={f.a} />
        </div>
      ))}
    </dl>
  </section>

  <!-- Closing CTA -->
  <section class="wrap pb-16 sm:pb-24">
    <div class="reveal sticker relative overflow-hidden bg-violet p-8 text-white sm:p-12">
      <div aria-hidden="true" class="orb right-[6%] top-1/2 hidden h-24 w-24 -translate-y-1/2 animate-drift [--orb-a:#D4F75B] [--orb-b:#8FBF1C] [--orb-c:#33470C] md:block"></div>
      <div class="relative z-10 grid max-w-2xl gap-4">
        <h2 class="text-2xl font-bold sm:text-[36px] sm:leading-[1.1]">Welk proces kost bij jullie te veel tijd?</h2>
        <p class="max-w-prose text-white/80">Je hoeft het niet uitgedacht te hebben. Eén berichtje met wat je stoort is genoeg om te bepalen of er iets te halen valt.</p>
        <div class="flex flex-wrap gap-3">
          <a href={wa} rel="noopener" class="btn btn-lime">Stuur een WhatsApp</a>
          <a href={`mailto:${SITE.email}`} class="btn btn-ghost border-white text-white hover:bg-white/10">Mail Micky</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
