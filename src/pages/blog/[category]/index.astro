---
import Layout from '../../../layouts/Layout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import { CATEGORIES } from '../../../content.config';
import { CATEGORY_LABELS } from '../../../config/site';
import { getPublishedArticles } from '../../../lib/articles';

export async function getStaticPaths() {
  return CATEGORIES.map((category) => ({ params: { category } }));
}
const { category } = Astro.params;
const label = CATEGORY_LABELS[category] ?? category;
const articles = (await getPublishedArticles()).filter((a) => a.data.category === category);
const descriptions: Record<string, string> = {
  ondernemen: 'Praktische artikelen over ondernemen, marketing, acquisitie en AI voor ondernemers.',
  digitalenomaden: 'Alles over werken en reizen combineren: bestemmingen, jobs, belasting en het echte leven als digital nomad.',
  'online-geld-verdienen': 'Eerlijke gidsen over online geld verdienen: affiliate marketing, bloggen, YouTube, webshops en meer.',
  web3: 'Crypto, NFTs en web3 uitgelegd, inclusief reviews van Nederlandse exchanges.',
  tips: 'Persoonlijke verhalen en lessen uit een vrij leven.',
  review: 'Eerlijke reviews van tools, cursussen en diensten die ik zelf gebruikte.',
};
---
<Layout title={`${label} – Blog`} description={descriptions[category]}>
  <section class="wrap py-12 sm:py-16">
    <p class="text-sm font-bold"><a href="/blog/" class="text-violet hover:underline">Blog</a></p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">{label}</h1>
    <p class="mt-3 max-w-prose text-lg text-muted">{descriptions[category]}</p>
    <p class="mt-2 text-sm font-bold text-muted">{articles.length} artikelen</p>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((a, i) => <ArticleCard article={a} delay={(i % 3) + 1} />)}
    </div>
  </section>
</Layout>
