---
import Layout from '../../layouts/Layout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { CATEGORY_LABELS, HIDDEN_FROM_LISTINGS } from '../../config/site';
import { getListedArticles } from '../../lib/articles';

const articles = await getListedArticles();
const categories = Object.entries(CATEGORY_LABELS).filter(([c]) => !HIDDEN_FROM_LISTINGS.includes(c));
---
<Layout title="Blog" description="Ruim 170 artikelen over ondernemen, online geld verdienen, werken en reizen als digital nomad en persoonlijke verhalen van Micky van Zadelhoff.">
  <section class="wrap py-12 sm:py-16">
    <p class="eyebrow">Blog</p>
    <h1 class="mt-2 text-4xl font-extrabold tracking-tight sm:text-5xl">Alles wat ik schreef sinds 2017.</h1>
    <p class="mt-3 max-w-prose text-lg text-muted">Eerlijk, persoonlijk en praktisch. Voorheen op De Moderne Nomaden, nu hier.</p>
    <nav aria-label="Categorieën" class="mt-6 flex flex-wrap gap-2">
      {categories.map(([slug, label]) => (
        <a href={`/blog/${slug}/`} class="chip bg-white shadow-sticker-sm transition-transform hover:-translate-y-0.5">{label}</a>
      ))}
    </nav>
    <div class="mt-12 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {articles.map((a, i) => <ArticleCard article={a} delay={(i % 3) + 1} />)}
    </div>
  </section>
</Layout>
