---
export const prerender = true;
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Blobs from '../components/Blobs.astro';
import { SITE } from '../config/site';

const page = await getEntry('pages', 'digital-nomad-boek');
if (!page) throw new Error('src/content/pages/digital-nomad-boek.md is missing');
const { Content } = await render(page);
const cover = '/images/migrated/digital-nomad-boek-verhalen-en-lessen-uit-een-vrij-leven-boek-cover-1.webp';
---
<Layout title="Gratis boek: Digital nomad" description={page.data.description ?? ''} image={cover}>
  <section class="relative overflow-hidden">
    <Blobs />
    <div class="wrap relative z-10 grid items-center gap-10 py-14 md:grid-cols-[3fr_2fr] sm:py-20">
      <div class="grid gap-5">
        <p class="animate-rise text-sm text-muted">Dit boek schreef ik over mijn jaren als digital nomad. Tegenwoordig train ik bedrijven in AI, <a href="/over/" class="font-bold text-violet underline decoration-lime decoration-[3px] underline-offset-2">dat verhaal staat hier</a>.</p>
        <p class="eyebrow animate-rise">Gratis download · geen e-mail nodig</p>
        <h1 class="text-[36px] font-extrabold leading-[1.05] tracking-tight animate-rise [animation-delay:.1s] sm:text-[52px]">Digital nomad: verhalen en lessen uit een <span class="highlight">vrij leven</span></h1>
        <p class="max-w-prose text-lg text-muted animate-rise [animation-delay:.2s]">Van een vanlife in de Balkan tot een fietstocht naar Turkije. Het eerlijke verhaal van een wereldreiziger die met vallen en opstaan een nieuwe levensstijl ontdekt. 176 pagina's.</p>
        <div class="animate-rise [animation-delay:.3s]"><a href="/downloads/Digital-Nomad-Boek.pdf" class="btn btn-primary">Download het boek (PDF)</a></div>
      </div>
      <img src={cover} alt="Boekcover: Digital nomad, verhalen en lessen uit een vrij leven" width="800" height="1000" class="sticker mx-auto w-full max-w-xs rotate-2 object-cover animate-rise [animation-delay:.25s]" />
    </div>
  </section>
  <article class="wrap py-8">
    <div class="prose prose-lg mx-auto max-w-prose">
      <Content />
    </div>
  </article>
  <section class="wrap py-12">
    <div class="reveal sticker grid items-center gap-6 bg-violet-soft p-8 sm:grid-cols-[auto_1fr_auto] sm:p-10">
      <img src="/images/micky/mick.webp" alt="Micky van Zadelhoff in een fauteuil, met een banaan als telefoon" width="400" height="400" loading="lazy" class="sticker h-28 w-28 object-cover sm:h-36 sm:w-36" />
      <div class="grid gap-2">
        <p class="eyebrow">En nu</p>
        <h2 class="text-2xl font-bold sm:text-3xl">Van reizen naar bouwen met AI.</h2>
        <p class="max-w-prose text-muted">De vrijheid uit dit boek gebruik ik nu om bedrijven te helpen met AI: een introductie van drie uur voor het hele team, of een bouwweek waarin we een automatisering neerzetten.</p>
      </div>
      <div class="flex flex-wrap gap-3">
        <a href="/ai-workshops/" class="btn btn-primary">Bekijk de AI-workshops</a>
        <a href={SITE.whatsappUrl} rel="noopener" class="btn btn-ghost">Stuur een WhatsApp</a>
      </div>
    </div>
  </section>
</Layout>
