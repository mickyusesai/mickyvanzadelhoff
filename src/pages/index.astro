---
export const prerender = true;
import Layout from '../layouts/Layout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import WorkshopCard from '../components/WorkshopCard.astro';
import ClientStrip from '../components/ClientStrip.astro';
import StatBar from '../components/StatBar.astro';
import Blobs from '../components/Blobs.astro';
import { getCollection } from 'astro:content';
import { FACTS, SITE } from '../config/site';
import { getListedArticles } from '../lib/articles';

const workshops = (await getCollection('workshops', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const recent = (await getListedArticles()).slice(0, 6);
const headline = ['Hoi,', 'ik', 'ben', 'Micky.', 'Ik', 'help', 'bedrijven'];
---
<Layout
  title="Micky van Zadelhoff – AI-workshops voor bedrijven"
  description={`AI-trainer en bouwer. ${FACTS.workshops} AI-workshops sinds ${FACTS.workshopsSince}, ${FACTS.participants} deelnemers, en de software die hij zelf met AI bouwt. In-company door heel Nederland.`}
>
  <section class="relative overflow-hidden">
    <Blobs />
    <div class="wrap relative z-10 grid items-center gap-12 py-14 md:grid-cols-[6fr_5fr] md:py-20">
      <div class="grid gap-6">
        <p class="eyebrow animate-rise">AI-trainer · ondernemer · bouwer</p>
        <h1 class="text-[40px] font-bold leading-[1.02] tracking-[-0.03em] sm:text-[54px] lg:text-[66px]">
          {headline.map((w, i) => <span class="hero-word" style={`--i:${i}`}>{w}</span>)}
          <span class="hero-word" style="--i:7"><span class="highlight">écht</span></span>
          {['aan', 'de', 'slag', 'met', 'AI.'].map((w, i) => <span class="hero-word" style={`--i:${i + 8}`}>{w}</span>)}
        </h1>
        <p class="max-w-prose text-lg leading-relaxed text-muted animate-rise [animation-delay:.6s] sm:text-xl">
          Geen abstracte praatjes, maar workshops waarin jouw team zelf ontdekt en bouwt. Van een introductie in drie uur tot een traject waarin ik meedraai en we samen een automatisering neerzetten die direct tijd bespaart.
        </p>
        <div class="flex flex-wrap gap-3 animate-rise [animation-delay:.75s]">
          <a href="/ai-workshops/" class="btn btn-primary">Bekijk de AI-workshops</a>
          <a href={SITE.whatsappUrl} rel="noopener" class="btn btn-ghost">Stuur een WhatsApp</a>
        </div>
      </div>
      <div class="relative mx-auto w-full max-w-[460px] animate-rise [animation-delay:.3s]">
        <div class="beam" aria-hidden="true"></div>
        <div class="absolute inset-0 translate-x-4 translate-y-4 rounded-[46%_54%_40%_60%/50%_40%_60%_50%] border-2 border-ink bg-violet"></div>
        <img src="/images/micky/micky-van-zadelhoff-portret.webp" alt="Micky van Zadelhoff" width="1200" height="1200"
             class="relative aspect-square w-full rounded-[46%_54%_40%_60%/50%_40%_60%_50%] border-2 border-ink object-cover" />
        <span class="chip absolute -right-2 top-6 bg-lime shadow-sticker-sm animate-bob [--tilt:8deg]">AI-trainer</span>
        <span class="chip absolute -left-3 bottom-10 bg-white shadow-sticker-sm animate-bob [--tilt:-6deg] [animation-delay:1.3s]">{FACTS.workshops} workshops · {FACTS.countries} landen</span>
      </div>
    </div>
  </section>

  <ClientStrip />

  <section class="band-dark relative overflow-hidden">
    <div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
      <div class="orb right-[6%] top-10 h-20 w-20 animate-drift [--orb-a:#D4F75B] [--orb-b:#8FBF1C] [--orb-c:#33470C] sm:h-28 sm:w-28"></div>
      <div class="orb left-[3%] bottom-16 h-12 w-12 animate-drift-slow [--orb-a:#C4B5FD] [--orb-b:#6D28D9] [--orb-c:#2E1065] sm:h-16 sm:w-16"></div>
      <div class="absolute -right-32 -top-32 h-96 w-96 rounded-full bg-violet/30 blur-3xl"></div>
    </div>
    <div class="wrap relative z-10 py-16 sm:py-24">
      <div class="reveal grid gap-3">
        <p class="eyebrow">In-company</p>
        <h2 class="max-w-3xl text-3xl font-bold tracking-tight sm:text-[44px] sm:leading-[1.08]">Twee workshops, één doel: dat jouw team AI <span class="text-lime">zelf</span> kan inzetten.</h2>
        <p class="max-w-prose text-white/70">Eerst zien wat er kan. Dan bouwen wat jullie nodig hebben.</p>
      </div>
      <div class="mt-10 grid gap-8 md:grid-cols-2">
        {workshops.map((w, i) => <WorkshopCard workshop={w} variant={i === 1 ? 'violet' : 'light'} delay={i + 1} />)}
      </div>
      <StatBar dark class="mt-14 border-t border-white/15 pt-10" />
    </div>
  </section>

  <section class="wrap py-16 sm:py-24">
    <div class="reveal grid items-center gap-10 md:grid-cols-[3fr_3fr]">
      <div class="relative">
        <img src="/images/micky/workshop-technogym.webp" alt="Micky van Zadelhoff geeft een AI-workshop bij Technogym Benelux" width="1200" height="689" loading="lazy"
             class="sticker w-full object-cover" />
        <span class="chip absolute -left-3 -top-3 bg-lime shadow-sticker-sm animate-bob [--tilt:-5deg]">Live bij Technogym</span>
      </div>
      <div class="grid gap-4">
        <p class="eyebrow">Over Micky</p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Ik bouw wat ik anderen leer bouwen.</h2>
        <p class="max-w-prose text-lg text-muted">Op ons kamp telde iemand elke week met de hand natte turflijstjes op om te weten wie wat gedronken had. Begin 2026 bouwde ik daar in een paar uur een app voor. Datzelfde jaar bracht ik <a href="https://easyreimburse.ai/" rel="noopener" class="font-bold text-violet underline decoration-lime decoration-[3px] underline-offset-2">EasyReimburse</a> op de markt, dat ruim veertig organisaties per project een volle werkweek scheelt. Ik heb geen programmeerachtergrond. Dat is precies waarom ik weet dat jouw team dit ook kan.</p>
        <a href="/over/" class="btn btn-ghost w-fit">Lees mijn verhaal</a>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="reveal sticker grid gap-6 bg-lime p-8 sm:p-10 md:grid-cols-[3fr_2fr] md:items-center">
      <div class="grid gap-3">
        <p class="eyebrow text-ink">Gratis boek</p>
        <h2 class="text-2xl font-bold sm:text-3xl">Digital nomad: verhalen en lessen uit een vrij leven</h2>
        <p class="max-w-prose text-ink/80">Het boek over mijn jaren als digital nomad: van een vanlife in de Balkan tot een fietstocht naar Turkije. 176 pagina's, direct te downloaden, geen e-mail nodig.</p>
      </div>
      <div class="flex md:justify-end">
        <a href="/boek/" class="btn btn-primary">Download het boek</a>
      </div>
    </div>
  </section>

  <section class="wrap py-16 sm:py-24">
    <div class="reveal flex flex-wrap items-end justify-between gap-4">
      <div class="grid gap-2">
        <p class="eyebrow">Blog</p>
        <h2 class="text-3xl font-bold tracking-tight sm:text-4xl">Uit het blog</h2>
        <p class="text-muted">Ruim 170 artikelen uit mijn jaren als De Moderne Nomaden, plus wat ik nu over AI schrijf.</p>
      </div>
      <a href="/blog/" class="btn btn-ghost">Alle artikelen</a>
    </div>
    <div class="mt-10 grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {recent.map((a, i) => <ArticleCard article={a} delay={(i % 3) + 1} />)}
    </div>
  </section>

  <section class="wrap pb-4">
    <div class="reveal sticker relative overflow-hidden bg-lime p-8 sm:p-12">
      <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-[38%] bg-ink [clip-path:polygon(28%_0,100%_0,100%_100%,0_100%)] md:block"></div>
      <div aria-hidden="true" class="orb right-[9%] top-1/2 hidden h-20 w-20 -translate-y-1/2 animate-drift [--orb-a:#D4F75B] [--orb-b:#8FBF1C] [--orb-c:#33470C] md:block"></div>
      <div class="relative z-10 grid max-w-2xl gap-4">
        <h2 class="text-3xl font-bold tracking-tight sm:text-[40px] sm:leading-[1.08]">Klaar om je team écht met AI te laten werken?</h2>
        <p class="max-w-prose text-ink/80">Een appje is genoeg. In een kort gesprek kijken we wat voor jouw team het meeste oplevert.</p>
        <div class="flex flex-wrap gap-3">
          <a href={SITE.whatsappUrl} rel="noopener" class="btn btn-primary">Stuur een WhatsApp</a>
          <a href={`mailto:${SITE.email}`} class="btn btn-ghost">Mail {SITE.email}</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
