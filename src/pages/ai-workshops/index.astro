---
export const prerender = true;
import Layout from '../../layouts/Layout.astro';
import WorkshopCard from '../../components/WorkshopCard.astro';
import Blobs from '../../components/Blobs.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config/site';

const workshops = (await getCollection('workshops', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="AI-workshops voor bedrijven" description="Twee praktische AI-workshops: een introductie van drie uur voor het hele team, of een bouwweek waarin we met Claude Code een automatisering neerzetten die direct tijd bespaart.">
  <section class="relative overflow-hidden">
    <Blobs />
    <div class="wrap relative z-10 grid gap-5 py-14 sm:py-20">
      <p class="eyebrow animate-rise">In-company · Nederland</p>
      <h1 class="max-w-4xl text-[38px] font-extrabold leading-[1.04] tracking-tight animate-rise [animation-delay:.1s] sm:text-[56px]">AI-workshops die je team <span class="highlight">zelf</span> laten bouwen.</h1>
      <p class="max-w-prose text-lg text-muted animate-rise [animation-delay:.2s] sm:text-xl">De ontwikkelingen gaan hard en de meeste teams zien door de bomen het bos niet meer. Daarom zijn er twee workshops: één om te zien wat er kan, één om het ook echt te bouwen.</p>
    </div>
  </section>
  <section class="wrap">
    <div class="grid gap-8 md:grid-cols-2">
      {workshops.map((w, i) => <WorkshopCard workshop={w} variant={i === 1 ? 'violet' : 'light'} delay={i + 1} />)}
    </div>
  </section>
  <section class="wrap py-16 sm:py-24">
    <div class="reveal sticker relative overflow-hidden bg-lime p-8 sm:p-12">
      <div aria-hidden="true" class="absolute inset-y-0 right-0 hidden w-[38%] bg-ink [clip-path:polygon(28%_0,100%_0,100%_100%,0_100%)] md:block"></div>
      <div aria-hidden="true" class="orb right-[9%] top-1/2 hidden h-20 w-20 -translate-y-1/2 animate-drift [--orb-a:#D4F75B] [--orb-b:#8FBF1C] [--orb-c:#33470C] md:block"></div>
      <div class="relative z-10 grid max-w-2xl gap-4">
        <p class="eyebrow text-ink">Even kennismaken?</p>
        <h2 class="text-2xl font-bold sm:text-[36px] sm:leading-[1.1]">Grootse offertes kunnen. Appen werkt sneller.</h2>
        <p class="max-w-prose text-ink/80">In een kort gesprek kijken we wat voor jouw team het meeste oplevert: eerst de introductie, of direct bouwen.</p>
        <div class="flex flex-wrap gap-3">
          <a href={SITE.whatsappUrl} rel="noopener" class="btn btn-primary">Stuur een WhatsApp</a>
          <a href={`mailto:${SITE.email}`} class="btn btn-ghost">Mail Micky</a>
        </div>
      </div>
    </div>
  </section>
</Layout>
