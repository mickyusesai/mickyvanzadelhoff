---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';
import { SITE } from '../../config/site';

const workshops = (await getCollection('workshops', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Layout title="AI-workshops voor bedrijven" description="Twee praktische AI-workshops: een introductie van drie uur voor het hele team, of een bouwweek waarin we met Claude Code een automatisering neerzetten die direct tijd bespaart.">
  <section class="mx-auto max-w-6xl px-5 py-12">
    <p class="text-sm font-semibold uppercase tracking-wide text-accent">In-company</p>
    <h1 class="mt-2 text-4xl font-bold tracking-tight">AI-workshops die je team zelf laten bouwen</h1>
    <p class="mt-3 max-w-prose text-lg text-muted">
      De ontwikkelingen gaan hard en de meeste teams zien door de bomen het bos niet meer. Daarom zijn er twee workshops: één om te zien wat er kan, één om het ook echt te bouwen.
    </p>
    <div class="mt-10 grid gap-6 md:grid-cols-2">
      {workshops.map((w) => (
        <a href={`/ai-workshops/${w.data.slug}/`} class="grid content-start gap-3 rounded-xl border border-line bg-white p-6 hover:border-accent">
          <p class="text-xs uppercase tracking-wide text-muted">{w.data.duration} · {w.data.location} · {w.data.participants}</p>
          <h2 class="text-2xl font-semibold">{w.data.title}</h2>
          <p class="text-muted">{w.data.subtitle}</p>
          <ul class="mt-2 grid gap-1 text-sm">
            {w.data.outcomes.map((o) => <li class="flex gap-2"><span class="text-accent" aria-hidden="true">✓</span>{o}</li>)}
          </ul>
          <p class="mt-2 font-semibold text-accent">{w.data.price} <span class="text-sm font-normal text-muted">{w.data.priceNote}</span></p>
        </a>
      ))}
    </div>
    <div class="mt-12 rounded-xl bg-accent-soft p-8">
      <h2 class="text-2xl font-bold">Even kennismaken?</h2>
      <p class="mt-2 max-w-prose text-muted">Grootse offertes kunnen, maar mailen of appen werkt eigenlijk het handigst. Dan bespreken we wat voor jouw team het meeste oplevert.</p>
      <div class="mt-4 flex flex-wrap gap-3">
        <a href={SITE.whatsappUrl} rel="noopener" class="rounded-md bg-accent px-5 py-3 font-semibold text-white hover:bg-accent-dark">Stuur een WhatsApp</a>
        <a href={`mailto:${SITE.email}`} class="rounded-md border border-line bg-white px-5 py-3 font-semibold hover:border-accent hover:text-accent">Mail Micky</a>
      </div>
    </div>
  </section>
</Layout>
