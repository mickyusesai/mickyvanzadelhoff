---
import Layout from '../layouts/Layout.astro';
import Blobs from '../components/Blobs.astro';
import { SITE } from '../config/site';
---
<Layout title="Contact" description="Vragen over een AI-workshop of hulp nodig? Mail of app Micky van Zadelhoff. Binnen 24 uur antwoord.">
  <section class="relative overflow-hidden">
    <Blobs />
    <div class="wrap grid gap-6 py-14 sm:py-20">
      <p class="eyebrow animate-rise">Contact</p>
      <h1 class="max-w-3xl text-[40px] font-extrabold leading-[1.02] tracking-tight animate-rise [animation-delay:.1s] sm:text-[58px]">Binnen 24 uur <span class="highlight">antwoord</span>.</h1>
      <p class="max-w-prose text-lg text-muted animate-rise [animation-delay:.2s] sm:text-xl">
        Heb je vragen over de AI-workshops of kun je mijn hulp ergens bij gebruiken? Je mag me een mailtje sturen of appen. Hoe dan ook krijg je snel van mij een antwoord ;).
      </p>
      <div class="grid gap-4 animate-rise [animation-delay:.3s] sm:grid-cols-2 sm:max-w-2xl">
        <a href={SITE.whatsappUrl} rel="noopener" class="sticker sticker-hover grid gap-2 bg-lime p-6">
          <p class="eyebrow text-ink">WhatsApp</p>
          <p class="font-display text-xl font-bold">{SITE.whatsapp}</p>
          <p class="text-sm text-ink/70">Het snelst. Stuur gewoon een berichtje.</p>
        </a>
        <a href={`mailto:${SITE.email}`} class="sticker sticker-hover grid gap-2 p-6">
          <p class="eyebrow">E-mail</p>
          <p class="font-display text-xl font-bold break-all">{SITE.email}</p>
          <p class="text-sm text-muted">Voor offertes en langere vragen.</p>
        </a>
      </div>
      <dl class="grid gap-1 text-sm text-muted">
        <div class="flex gap-3"><dt class="w-20 font-bold text-ink">Naam</dt><dd>{SITE.name}</dd></div>
        <div class="flex gap-3"><dt class="w-20 font-bold text-ink">KVK</dt><dd>{SITE.kvk}</dd></div>
        <div class="flex gap-3"><dt class="w-20 font-bold text-ink">LinkedIn</dt><dd><a href={SITE.linkedin} rel="noopener" class="text-violet hover:underline">Micky van Zadelhoff</a></dd></div>
      </dl>
    </div>
  </section>
</Layout>
