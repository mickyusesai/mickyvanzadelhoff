---
export const prerender = true;
import { getEntry, render } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import PressStrip from '../components/PressStrip.astro';
import Blobs from '../components/Blobs.astro';

const page = await getEntry('pages', 'over-mij');
if (!page) throw new Error('src/content/pages/over-mij.md is missing');
const { Content } = await render(page);
---
<Layout title={page.data.title} description={page.data.description ?? ''} image="/images/micky/mick-van-zadelhoff-de-moderne-nomaden.webp">
  <section class="relative overflow-hidden">
    <Blobs />
    <div class="wrap relative z-10 grid items-center gap-10 py-14 md:grid-cols-[3fr_2fr] sm:py-20">
      <div class="grid gap-5">
        <p class="eyebrow animate-rise">Over Micky</p>
        <h1 class="text-[40px] font-extrabold leading-[1.02] tracking-tight animate-rise [animation-delay:.1s] sm:text-[58px]">Micky van Zadelhoff</h1>
        <p class="max-w-prose text-xl text-muted animate-rise [animation-delay:.2s]">Digital nomad, AI-trainer en luchtkasteelarchitect. Drie verhaaltjes zeggen meer dan een cv.</p>
      </div>
      <div class="relative mx-auto w-full max-w-sm animate-rise [animation-delay:.3s]">
        <img src="/images/micky/mick-van-zadelhoff-de-moderne-nomaden.webp" alt="Micky van Zadelhoff" width="1200" height="956" class="sticker w-full object-cover" />
        <span class="chip absolute -left-3 top-6 bg-lime shadow-sticker-sm animate-bob [--tilt:-6deg]">Fietste naar Turkije</span>
      </div>
    </div>
  </section>
  <PressStrip />
  <article class="wrap py-12">
    <div class="prose prose-lg mx-auto max-w-prose">
      <Content />
    </div>
  </article>
</Layout>
