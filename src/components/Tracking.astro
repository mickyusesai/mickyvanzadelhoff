---
/**
 * Conversion tracking and the ChatGPT Ads source (handoff 2026-09-29, section 5).
 * - Remembers utm_source=chatgpt in sessionStorage, adds " (gezien in ChatGPT)" to every WhatsApp
 *   message on the site while the session lasts, and fills the hidden `bron` field of the intake form.
 *   Google Ads visitors (gclid/gbraid/wbraid, or utm_source=google with a paid medium) get bron
 *   "google-ads" (no WhatsApp label); their conversions are imported into Google Ads from GA4.
 * - Reports "contact" on WhatsApp, mail, phone and agenda clicks and "lead" on a sent form (once per
 *   session per variant, param `voor`), to GA4 (gtag) and to window.__adsTrack when the pixel bridge in
 *   src/config/pixel.ts defines it. IntakeForm.astro calls window.mvzLead after a successful fetch submit;
 *   the no-JS path (?status=sent on a page with the form) is handled here.
 * - Sends Google Ads conversions (SITE.googleAdsConversions, 2026-10-06): WhatsApp click, mail click,
 *   form sent, agenda click. Clicks are caught by one listener on document (capture phase), so links
 *   added later count too; nothing is prevented or delayed and the hit goes out with
 *   transport_type 'beacon'. Without window.gtag (no Google tag on the page) nothing is sent.
 */
import { ADS_PIXEL } from '../config/pixel';
import { SITE } from '../config/site';
const events = ADS_PIXEL.events;
const adsConversions = SITE.googleAdsConversions;
---
{ADS_PIXEL.snippet && <Fragment set:html={ADS_PIXEL.snippet} />}
{ADS_PIXEL.bridge && <script is:inline set:html={ADS_PIXEL.bridge} />}
<script is:inline define:vars={{ events, adsConversions }}>
  (function () {
    var store = {
      get: function (k) { try { return sessionStorage.getItem(k) || ''; } catch (e) { return ''; } },
      set: function (k, v) { try { sessionStorage.setItem(k, v); } catch (e) {} }
    };
    var params = new URLSearchParams(location.search);
    var src = (params.get('utm_source') || '').toLowerCase();
    var medium = (params.get('utm_medium') || '').toLowerCase();
    if (src === 'chatgpt') {
      store.set('bron', 'chatgpt');
      if (params.get('utm_campaign')) store.set('campagne', params.get('utm_campaign'));
    } else if (params.get('gclid') || params.get('gbraid') || params.get('wbraid') || (src === 'google' && /cpc|paid|ppc/.test(medium))) {
      // Google Ads (2026-10-05): conversions are imported from GA4; the source shows in the intake mail.
      store.set('bron', 'google-ads');
      if (params.get('utm_campaign')) store.set('campagne', params.get('utm_campaign'));
    }
    var bron = store.get('bron');

    function track(name, extra) {
      var data = Object.assign({ pagina: location.pathname, bron: bron || 'direct' }, extra || {});
      try { if (window.gtag) window.gtag('event', name, data); } catch (e) {}
      try { if (window.__adsTrack) window.__adsTrack(name, data); } catch (e) {}
      try { (window.dataLayer = window.dataLayer || []).push({ event: name, data: data }); } catch (e) {}
    }
    window.mvzTrack = track;
    // Google Ads conversion. Same consent behaviour as the tags themselves: if gtag is not on the page,
    // nothing happens. No value or currency.
    function adsConversion(kind) {
      var target = adsConversions && adsConversions[kind];
      if (!target || typeof window.gtag !== 'function') return;
      try { window.gtag('event', 'conversion', { send_to: target, transport_type: 'beacon' }); } catch (e) {}
    }
    function lead(extra) {
      var voor = (extra && extra.voor) || 'automatisering';
      if (store.get('lead-' + voor)) return;
      store.set('lead-' + voor, '1');
      track(events.lead, Object.assign({ voor: voor }, extra || {}));
      adsConversion('form');
    }
    window.mvzLead = lead;

    var waLinks = document.querySelectorAll('a[href^="https://wa.me/"]');
    for (var i = 0; i < waLinks.length; i++) {
      var a = waLinks[i];
      if (bron === 'chatgpt') {
        try {
          var u = new URL(a.href); var text = u.searchParams.get('text');
          if (!text) u.searchParams.set('text', 'Hoi Micky (gezien in ChatGPT): ');
          else if (text.indexOf('gezien in ChatGPT') === -1) u.searchParams.set('text', text.replace(/\s+$/, '') + ' (gezien in ChatGPT)' + (/:\s*$/.test(text) ? ' ' : ''));
          a.href = u.toString();
        } catch (e) {}
      }
    }

    // One delegated listener for every contact link on the page, including links added later.
    // Capture phase, so it runs even if another handler stops the event; it never calls preventDefault.
    function onLinkClick(e) {
      if (e.type === 'auxclick' && e.button !== 1) return; // middle click opens a tab; ignore right click
      var el = e.target;
      var a = el && el.closest ? el.closest('a[href]') : null;
      if (!a) return;
      var href = a.getAttribute('href') || '';
      var host = '';
      try { host = new URL(a.href, location.href).hostname.toLowerCase(); } catch (err) {}
      if (host === 'wa.me' || host === 'api.whatsapp.com') {
        track(events.contact, { kanaal: 'whatsapp' });
        adsConversion('whatsapp');
      } else if (/^mailto:/i.test(href)) {
        track(events.contact, { kanaal: 'mail' });
        adsConversion('mail');
      } else if (/^tel:/i.test(href)) {
        track(events.contact, { kanaal: 'telefoon' });
      } else if (host === 'calendar.app.google') {
        track(events.contact, { kanaal: 'agenda' });
        adsConversion('agenda');
      }
    }
    document.addEventListener('click', onLinkClick, true);
    document.addEventListener('auxclick', onLinkClick, true);

    if (bron) {
      var bronFields = document.querySelectorAll('input[name="bron"]');
      for (var k = 0; k < bronFields.length; k++) bronFields[k].value = bron;
    }

    var voorField = document.querySelector('input[name="voor"]');
    if (voorField && params.get('status') === 'sent') lead({ voor: voorField.value });
  })();
</script>
