---
import { NAV, SITE } from '../config/site';
const year = new Date().getFullYear();
---
<footer class="mt-24 bg-ink text-white">
  <div class="wrap grid gap-10 py-14 md:grid-cols-[2fr_1fr_1fr]">
    <div class="grid gap-4">
      <p class="font-display text-2xl font-bold">Micky <span class="text-lime">van Zadelhoff</span></p>
      <p class="max-w-md text-white/75">{SITE.tagline}. Voorheen De Moderne Nomaden: alle artikelen staan nu hier, onder mijn eigen naam.</p>
      <a href={SITE.whatsappUrl} rel="noopener" class="btn btn-lime w-fit">Stuur een WhatsApp</a>
    </div>
    <nav aria-label="Voettekst">
      <p class="eyebrow mb-3 text-lime">Pagina's</p>
      <ul class="grid gap-2 text-white/85">
        {NAV.map((item) => <li><a href={item.href} class="hover:text-lime">{item.label}</a></li>)}
        <li><a href="/privacy/" class="hover:text-lime">Privacy</a></li>
        <li><a href="/rss.xml" class="hover:text-lime">RSS</a></li>
      </ul>
    </nav>
    <div>
      <p class="eyebrow mb-3 text-lime">Contact</p>
      <ul class="grid gap-2 text-white/85">
        <li><a href={`mailto:${SITE.email}`} class="hover:text-lime">{SITE.email}</a></li>
        <li><a href={SITE.whatsappUrl} rel="noopener" class="hover:text-lime">{SITE.whatsapp}</a></li>
        <li><a href={SITE.linkedin} rel="noopener" class="hover:text-lime">LinkedIn</a></li>
        <li class="text-white/55">KVK {SITE.kvk}</li>
      </ul>
    </div>
  </div>
  <div class="border-t border-white/10">
    <div class="wrap flex flex-wrap items-center justify-between gap-2 py-5 text-sm text-white/55">
      <p>© {year} {SITE.name}</p>
      <p>Gemaakt met Astro, gebouwd met AI.</p>
    </div>
  </div>
</footer>
