---
/**
 * Decorative background for heroes: soft drifting colour fields plus two glossy orbs,
 * in the spirit of the floating 3D shapes on the reference site. CSS only, transform-only
 * motion, hidden from assistive technology. The hero's content wrapper must be
 * `relative z-10` so this layer always stays behind text and images.
 */
interface Props { orbs?: boolean; }
const { orbs = true } = Astro.props;
---
<div aria-hidden="true" class="pointer-events-none absolute inset-0 z-0 overflow-hidden">
  <div class="absolute -left-24 top-10 h-72 w-72 rounded-[46%_54%_40%_60%/50%_40%_60%_50%] bg-violet/15 blur-2xl animate-drift"></div>
  <div class="absolute right-[-6rem] top-24 h-96 w-96 rounded-[54%_46%_60%_40%/40%_60%_40%_60%] bg-lime/50 blur-2xl animate-drift-slow"></div>
  <div class="absolute bottom-[-4rem] left-1/3 h-56 w-56 rounded-full bg-coral/15 blur-2xl animate-drift"></div>
  {orbs && (
    <>
      <div class="orb right-[4%] top-6 h-14 w-14 animate-drift-slow [--orb-a:#D4F75B] [--orb-b:#8FBF1C] [--orb-c:#33470C] sm:right-[6%] sm:h-24 sm:w-24"></div>
      <div class="orb right-[42%] bottom-[12%] hidden h-14 w-14 animate-drift [--orb-a:#A78BFA] [--orb-b:#6D28D9] [--orb-c:#2E1065] md:block"></div>
    </>
  )}
</div>
