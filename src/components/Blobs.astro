---
/** Decorative drifting shapes behind a hero. Pure CSS motion, transform only, hidden from AT. */
---
<div aria-hidden="true" class="pointer-events-none absolute inset-0 -z-10 overflow-hidden">
  <div class="absolute -left-24 top-10 h-72 w-72 rounded-[46%_54%_40%_60%/50%_40%_60%_50%] bg-violet/15 blur-2xl animate-drift"></div>
  <div class="absolute right-[-6rem] top-24 h-96 w-96 rounded-[54%_46%_60%_40%/40%_60%_40%_60%] bg-lime/50 blur-2xl animate-drift-slow"></div>
  <div class="absolute bottom-[-4rem] left-1/3 h-56 w-56 rounded-full bg-coral/15 blur-2xl animate-drift"></div>
</div>
